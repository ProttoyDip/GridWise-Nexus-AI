# LLM provider configuration (fill in for local/deployed use; never commit real values)
#
# Single provider (backward compatible):
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
#
# Multi-provider failover chain (preferred): set LLM_PROVIDERS to a
# comma-separated, priority-ordered list of provider names. GridWise tries
# each in turn and automatically fails over to the next one when the
# current provider reports quota/rate-limit exhaustion. Supported names:
# anthropic, openai, openrouter, nararouter, experimentallab.
# LLM_PROVIDERS=openrouter,nararouter,experimentallab
#
# For EACH provider named above, set its own API key
# (LLM_API_KEY_<NAME>, name upper-cased):
# LLM_API_KEY_OPENROUTER=
# LLM_API_KEY_NARAROUTER=
# LLM_API_KEY_EXPERIMENTALLAB=
#
# Model selection per provider (optional). Leave LLM_MODEL_<NAME> /
# LLM_MODELS_<NAME> unset to use the built-in curated list of verified
# free models for that provider, rotating through all of them before
# falling over to the next provider on quota exhaustion:
# LLM_MODEL_<NAME>=<single model id>   # pin to exactly one model
# LLM_MODELS_<NAME>=<id1>,<id2>,...    # pin to a custom ordered list
#
# Check GET /llm/status once the server is running to confirm which
# provider(s)/model(s) are actually active (never exposes the keys).

# Service configuration
PORT=8000
